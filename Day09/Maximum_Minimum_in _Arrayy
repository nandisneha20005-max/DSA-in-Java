
public class Main {
    public static void main(String[] args) {
        int[] arr = {3, 5, 1, 8, 2, 9};
        int n = arr.length;

        int min, max;
        int i;

        if (n % 2 == 0) {
            if (arr[0] < arr[1]) {
                min = arr[0];
                max = arr[1];
            } else {
                min = arr[1];
                max = arr[0];
            }
            i = 2;
        } else {
            min = max = arr[0];
            i = 1;
        }

        while (i < n - 1) {
            int small, large;

            if (arr[i] < arr[i + 1]) {
                small = arr[i];
                large = arr[i + 1];
            } else {
                small = arr[i + 1];
                large = arr[i];
            }

            if (small < min) {
                min = small;
            }

            if (large > max) {
                max = large;
            }

            i += 2;
        }

        System.out.println("Minimum = " + min);
        System.out.println("Maximum = " + max);
    }
}
